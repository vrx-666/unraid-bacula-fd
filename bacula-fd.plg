<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name      "bacula-fd">
<!ENTITY author    "VRX">
<!ENTITY version   "@VERSION@">
<!ENTITY pkg       "bacula-fd-15.0.3-x86_64-1_vrx.txz">
<!ENTITY md5       "@MD5@">
<!ENTITY github    "vrx-666/unraid-bacula-fd">
<!ENTITY pluginURL "https://github.com/&github;/releases/latest/download/&name;.plg">
<!ENTITY plgdir    "/boot/config/plugins/&name;">
]>

<PLUGIN name="&name;" author="&author;" version="&version;" pluginURL="&pluginURL;" min="7.0.0"
        icon="hdd-o" support="https://github.com/&github;/issues">

<!-- Template: @VERSION@ and @MD5@ are filled in by .github/workflows/release.yml. -->

<CHANGES>
See https://github.com/&github;/releases
</CHANGES>

<!-- Drop packages and files from previous versions: plugin never overwrites an existing file,
     so on update the INLINE files below would otherwise stay old. -->
<FILE Run="/bin/bash">
<INLINE>
rm -f $(ls &plgdir;/*.txz 2>/dev/null &#124; grep -v '&pkg;')
rm -rf /usr/local/emhttp/plugins/&name; /etc/rc.d/rc.bacula-fd
</INLINE>
</FILE>

<FILE Name="&plgdir;/&pkg;" Run="upgradepkg --install-new --reinstall">
<URL>https://github.com/&github;/releases/download/&version;/&pkg;</URL>
<MD5>&md5;</MD5>
</FILE>

<FILE Name="/etc/rc.d/rc.bacula-fd" Mode="0755">
<INLINE>
<![CDATA[
#!/bin/bash
# Start/stop the Bacula file daemon. Config lives on the flash drive.
CONF=/boot/config/plugins/bacula-fd/bacula-fd.conf

case "$1" in
  start)
    pgrep -x bacula-fd >/dev/null && { echo "bacula-fd already running"; exit 0; }
    mkdir -p /var/lib/bacula
    /usr/sbin/bacula-fd -t -c "$CONF" || { echo "bacula-fd: config test failed, not starting"; exit 1; }
    /usr/sbin/bacula-fd -c "$CONF" && echo "bacula-fd started"
    ;;
  stop)
    pkill -x bacula-fd && echo "bacula-fd stopped"
    ;;
  restart)
    "$0" stop; sleep 1; "$0" start
    ;;
  status)
    pgrep -x bacula-fd >/dev/null && echo "bacula-fd is running" || { echo "bacula-fd is stopped"; exit 1; }
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status}"; exit 1
    ;;
esac
]]>
</INLINE>
</FILE>

<!-- Settings > Network Services > Bacula File Daemon -->
<FILE Name="/usr/local/emhttp/plugins/&name;/BaculaFD.page">
<INLINE>
<![CDATA[
Menu="NetworkServices"
Title="Bacula File Daemon"
Icon="hdd-o"
Tag="hdd-o"
---
<?
$file = "/boot/config/plugins/bacula-fd/bacula-fd.conf";
$text = str_replace(["\r\n","\r"], "\n", @file_get_contents($file) ?: '');
$running = exec("pgrep -x bacula-fd") !== '';
?>
<form markdown="1" method="POST" action="/update.php" target="progressFrame">
<input type="hidden" name="#command" value="/plugins/bacula-fd/scripts/rc">
_(Status)_:
: <?=$running ? "<span class='green-text'>_(Running)_</span>" : "<span class='red-text'>_(Stopped)_</span>"?>

&nbsp;
: <button type="submit" name="#arg[1]" value="start" style="max-width:500px" <?=$running?'disabled':''?>>_(Start)_</button>
  <button type="submit" name="#arg[1]" value="stop" style="max-width:500px" <?=$running?'':'disabled'?>>_(Stop)_</button>
  <button type="submit" name="#arg[1]" value="restart" style="max-width:500px" <?=$running?'':'disabled'?>>_(Restart)_</button>
</form>

<script>
function saveConf() {
  $.post('/plugins/bacula-fd/include/save.php', {text: $('#conf').val(), csrf_token: csrf_token}, function(err) {
    if (err) swal({title: "_(Configuration not saved)_", text: $('<pre style="text-align:left">').text(err).prop('outerHTML'), html: true, type: 'error'});
    else location.reload();
  });
}
</script>
<form markdown="1" onsubmit="return false">
_(Configuration)_:
: <textarea id="conf" spellcheck="false" cols="80" rows="<?=substr_count($text,"\n")+1?>" style="font-family:monospace;max-width:500px"><?=htmlspecialchars($text)?></textarea>

&nbsp;
: <input type="button" value="_(Apply)_" onclick="saveConf()" style="max-width:500px"><input type="button" value="_(Done)_" onclick="done()" style="max-width:500px">

&nbsp;
: <span>_(The configuration is checked before saving. If it has errors, it is not saved and your changes stay in the editor.)_<br>
  _(Restart the daemon to load the new configuration. A running backup job will fail.)_<br>
  _(The daemon starts automatically when the server boots. Stopping the array restarts it, even if it was stopped here.)_</span>
</form>
]]>
</INLINE>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/&name;/include/save.php">
<INLINE>
<![CDATA[
<?
// Called by BaculaFD.page: save the config only if bacula-fd accepts it. Prints errors, nothing on success.
$file = "/boot/config/plugins/bacula-fd/bacula-fd.conf";
$tmp = tempnam("/tmp", "bacula-fd");
file_put_contents($tmp, str_replace(["\r\n","\r"], "\n", $_POST['text'] ?? ''));
exec("/usr/sbin/bacula-fd -t -c ".escapeshellarg($tmp)." 2>&1", $out, $rc);
if ($rc === 0) copy($tmp, $file);
else echo str_replace($tmp, "bacula-fd.conf", implode("\n", array_unique($out)));
unlink($tmp);
?>]]>
</INLINE>
</FILE>

<!-- update.php only runs commands under the webGui root. -->
<FILE Name="/usr/local/emhttp/plugins/&name;/scripts/rc" Mode="0755">
<INLINE>
#!/bin/bash
exec /etc/rc.d/rc.bacula-fd "$1" 2>&amp;1
</INLINE>
</FILE>

<!-- An FD reading /mnt keeps the shares busy and the array stop hangs (tested on 7.3.3).
     Stop it when the array starts stopping (a running job fails), start it again once stopped. -->
<FILE Name="/usr/local/emhttp/plugins/&name;/event/stopping" Mode="0755">
<INLINE>
#!/bin/bash
/etc/rc.d/rc.bacula-fd stop | logger -t bacula-fd
</INLINE>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/&name;/event/stopped" Mode="0755">
<INLINE>
#!/bin/bash
/etc/rc.d/rc.bacula-fd start | logger -t bacula-fd
</INLINE>
</FILE>

<!-- First install: write a default config with a random password. Never overwrite an existing one. -->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
CONF=/boot/config/plugins/bacula-fd/bacula-fd.conf
if [ ! -f "$CONF" ]; then
  PASS=$(openssl rand -base64 33)
  cat > "$CONF" <<EOF
# Bacula file daemon config. Edit, then: /etc/rc.d/rc.bacula-fd restart
# The Director below must have a matching Client resource with this Password.
Director {
  Name = bacula-dir
  Password = "$PASS"
}

FileDaemon {
  Name = $(hostname)-fd
  FDport = 9102
  WorkingDirectory = /var/lib/bacula
  Pid Directory = /var/run
  Plugin Directory = /usr/lib64/bacula
  Maximum Concurrent Jobs = 20
}

Messages {
  Name = Standard
  director = bacula-dir = all, !skipped, !restored
}
EOF
  echo "Created $CONF -- set the Director name to match your server."
  echo "Client password: $PASS"
fi
# Restart, not start: after an update the old binary would keep running until reboot.
/etc/rc.d/rc.bacula-fd restart
]]>
</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>
/etc/rc.d/rc.bacula-fd stop
removepkg &pkg;
rm -f /etc/rc.d/rc.bacula-fd &plgdir;/*.txz
rm -rf /usr/local/emhttp/plugins/&name;
echo "bacula-fd removed. Config kept in &plgdir;/"
</INLINE>
</FILE>

</PLUGIN>
